# Browser-safe configuration. Values prefixed with NEXT_PUBLIC_ are bundled
# into client code, so they must never contain privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Phase 1 intentionally has no server-only environment variables. Never put a
# Supabase service-role key or any storage secret in a NEXT_PUBLIC_ variable.
